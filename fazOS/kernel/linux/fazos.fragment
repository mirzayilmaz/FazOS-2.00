# FazOS Linux cekirdegi - yapilandirma parcasi (defconfig uzerine eklenir)
CONFIG_LOCALVERSION="-fazos"
CONFIG_DEFAULT_HOSTNAME="fazos"
CONFIG_EFI_STUB=y
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_XZ=y
CONFIG_OVERLAY_FS=y
CONFIG_BLK_DEV_LOOP=y
CONFIG_ISO9660_FS=y
CONFIG_JOLIET=y
CONFIG_EXT4_FS=y
CONFIG_VFAT_FS=y
CONFIG_EXFAT_FS=m
CONFIG_NTFS3_FS=m
CONFIG_USB_STORAGE=m
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_NET=m
CONFIG_E1000=m
CONFIG_E1000E=m
CONFIG_SND_HDA_INTEL=m
CONFIG_SND_INTEL8X0=m
CONFIG_DRM_VBOXVIDEO=m
CONFIG_DRM_VMWGFX=m
CONFIG_DRM_BOCHS=m
CONFIG_VBOXGUEST=m
CONFIG_FRAMEBUFFER_CONSOLE=y
